#include <dt-bindings/usb/audio.h>
#include "../common/flash.dtsi"

/ {
    media_hid: media_hid {
        compatible = "zephyr,hid-device";
        label = "Headphone controls";
        in-report-size = <2>;
        in-polling-period-us = <1000>;
    };

    rgb_hid: rgb_hid {
        compatible = "zephyr,hid-device";
        label = "Headphone RGB";
        in-report-size = <64>;
        in-polling-period-us = <4000>;
    };

    usb_audio: usb_audio {
        compatible = "zephyr,uac2";
        full-speed;
        audio-function = <AUDIO_FUNCTION_HEADSET>;

        audio_clock: clock {
            compatible = "zephyr,uac2-clock-source";
            clock-type = "internal-fixed";
            sof-synchronized;
            frequency-control = "read-only";
            sampling-frequencies = <48000>;
        };

        usb_play: usb_playback {
            compatible = "zephyr,uac2-input-terminal";
            clock-source = <&audio_clock>;
            terminal-type = <USB_TERMINAL_STREAMING>;
            front-left;
            front-right;
        };

        headphones_out: headphones_out {
            compatible = "zephyr,uac2-output-terminal";
            data-source = <&usb_play>;
            clock-source = <&audio_clock>;
            terminal-type = <OUTPUT_TERMINAL_HEADPHONES>;
        };

        mic_in: microphone {
            compatible = "zephyr,uac2-input-terminal";
            clock-source = <&audio_clock>;
            terminal-type = <INPUT_TERMINAL_MICROPHONE>;
            front-center;
        };

        usb_mic: usb_capture {
            compatible = "zephyr,uac2-output-terminal";
            data-source = <&mic_in>;
            clock-source = <&audio_clock>;
            terminal-type = <USB_TERMINAL_STREAMING>;
        };

        playback_stream {
            compatible = "zephyr,uac2-audio-streaming";
            linked-terminal = <&usb_play>;
            subslot-size = <2>;
            bit-resolution = <16>;
        };

        mic_stream {
            compatible = "zephyr,uac2-audio-streaming";
            linked-terminal = <&usb_mic>;
            subslot-size = <2>;
            bit-resolution = <16>;
        };
    };
};
